Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: camera_hand_base_link
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/RobotModel
      Name: Estimated hand - NOT measured
      Enabled: true
      Alpha: 1
      Visual Enabled: true
      Collision Enabled: false
      Description Source: Topic
      Description Topic:
        Value: /hand_preview/robot_description
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.02
      Plane Cell Count: 10
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 0.45
      Focal Point: {X: 0.0, Y: 0.0, Z: 0.10}
      Pitch: 0.5
      Yaw: 0.8
Window Geometry:
  Width: 1000
  Height: 850
